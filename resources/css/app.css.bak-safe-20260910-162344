@import 'bootstrap/dist/css/bootstrap.min.css';

/* =========================================================
   RESET / BASE
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
}

body {
    background: #f4f7fb;
    color: #17263b;
    font: 13px Arial, sans-serif;
}

button,
input,
select,
textarea {
    font: inherit;
    cursor: pointer;
}


/* =========================================================
   APP LAYOUT
========================================================= */

.side {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 100;
    width: 220px;
    padding: 16px 10px;
    background: #062444;
    color: #fff;
    overflow-y: auto;
}

.main {
    min-height: 100vh;
    margin-left: 220px;
}

.top {
    position: sticky;
    top: 0;
    z-index: 90;

    display: flex;
    align-items: center;
    gap: 16px;

    height: 64px;
    padding: 0 22px;

    background: #fff;
    border-bottom: 1px solid #dce5ef;
}

.wrap {
    width: 100%;
    padding: 18px;
}


/* =========================================================
   SIDEBAR
========================================================= */

.logo {
    padding: 8px 10px 18px;
    border-bottom: 1px solid #244361;
    font-weight: 900;
}

.logo small {
    display: block;
    margin-top: 4px;
    color: #39a4ff;
}

.navtitle {
    margin: 20px 10px 7px;
    color: #9db2c9;
    font-size: 9px;
}

.nav a {
    display: block;
    padding: 10px;
    border-radius: 6px;
    color: #eef6ff;
    text-decoration: none;
    font-size: 11px;
}

.nav a:hover {
    background: #123b63;
}

.nav a.active {
    background: #0969e8;
}


/* =========================================================
   TOPBAR
========================================================= */

.spacer {
    flex: 1;
}

.online {
    color: #19a15f;
    font-size: 10px;
}

.user {
    font-size: 11px;
    font-weight: 900;
}

.logout-form {
    margin: 0;
}

.logout-btn {
    border: 0;
    background: transparent;
    color: #d9534f;
    font-size: 11px;
    font-weight: 700;
}

.logout-btn:hover {
    text-decoration: underline;
}


/* =========================================================
   PAGE HEADING
========================================================= */

.heading {
    margin: 6px 0 16px;
}

.heading h1,
.page-title h1 {
    margin: 0;
    font-size: 22px;
}

.heading p,
.page-title p {
    margin: 5px 0 0;
    color: #718096;
    font-size: 11px;
}


/* =========================================================
   GENERIC CARD
========================================================= */

.card {
    margin-bottom: 15px;
    background: #fff;
    border: 1px solid #dce5ef;
    border-radius: 8px;
    overflow: hidden;
}

.card-head,
.head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    padding: 13px 15px;

    border-bottom: 1px solid #dce5ef;

    font-size: 11px;
    font-weight: 900;
}

.card-body,
.body {
    padding: 15px;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    min-height: 34px;
    padding: 8px 13px;

    border: 1px solid #dce5ef;
    border-radius: 6px;

    background: #fff;
    color: #17263b;

    font-size: 11px;
    font-weight: 700;

    cursor: pointer;
}

.btn:hover {
    background: #f5f8fc;
}

.btn-primary,
.btn.primary {
    border-color: #0969e8;
    background: #0969e8;
    color: #fff;
}

.btn-primary:hover,
.btn.primary:hover {
    border-color: #0758c7;
    background: #0758c7;
}

.btn-secondary {
    background: #fff;
    color: #17263b;
}

.btn-link {
    border: 0;
    background: transparent;
    color: #0969e8;
    font-size: 11px;
    font-weight: 700;
}

.btn.danger {
    border-color: #fecaca;
    color: #dc2626;
}


/* =========================================================
   FORM
========================================================= */

.form-group {
    margin-bottom: 12px;
}

.form-group label,
.field label {
    display: block;
    margin-bottom: 5px;
    font-size: 10px;
    font-weight: 700;
}

.form-control,
.field input,
.field select {
    width: 100%;
    height: 38px;
    padding: 0 10px;

    border: 1px solid #dce5ef;
    border-radius: 6px;

    background: #fff;
    color: #17263b;

    outline: none;
    font-size: 11px;
}

.form-control {
    height: auto;
    padding: 9px;
}

.form-control:focus,
.field input:focus,
.field select:focus {
    border-color: #0969e8;
}


/* =========================================================
   MODAL
========================================================= */

.modal {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(6, 36, 68, .45);
}

.modal.is-open {
    display: flex;
}

.modal-box {
    width: 100%;
    max-width: 460px;

    background: #fff;
    border: 1px solid #dce5ef;
    border-radius: 8px;

    box-shadow: 0 15px 40px rgba(0, 0, 0, .18);

    overflow: hidden;
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 14px 16px;

    border-bottom: 1px solid #dce5ef;
}

.modal-title {
    margin: 0;
    font-size: 13px;
    font-weight: 900;
}

.modal-close {
    padding: 0;
    border: 0;
    background: transparent;
    color: #718096;
    font-size: 20px;
}

.modal-body {
    padding: 16px;
}

.modal-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;

    padding: 12px 16px;

    border-top: 1px solid #dce5ef;
}


/* =========================================================
   DATATABLE
========================================================= */

.table-toolbar,
.table-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    padding: 12px 15px;
}

.table-toolbar {
    border-bottom: 1px solid #dce5ef;
}

.table-search {
    width: 220px;
    height: 34px;
    padding: 8px 10px;

    border: 1px solid #dce5ef;
    border-radius: 6px;

    font-size: 11px;
}

.table-search:focus {
    outline: none;
    border-color: #0969e8;
}

.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table th,
.data-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #edf1f5;

    text-align: left;
    font-size: 11px;
}

.data-table th {
    background: #f8fafc;
    color: #53657a;
    font-size: 10px;
    font-weight: 900;
    white-space: nowrap;
}

.data-table tbody tr:hover {
    background: #f8fafc;
}

.table-action {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

.action-icon {
    width: 32px;
    height: 32px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid;
    border-radius: 6px;

    background: transparent;
}

.action-icon svg {
    width: 16px;
    height: 16px;

    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.action-edit {
    color: #475569;
    background: #f8fafc;
    border-color: #cbd5e1;
}

.action-edit:hover {
    background: #e2e8f0;
}

.action-danger {
    color: #dc2626;
    background: #fef2f2;
    border-color: #fecaca;
}

.action-danger:hover {
    background: #fee2e2;
}

.action-success {
    color: #16a34a;
    background: #f0fdf4;
    border-color: #bbf7d0;
}

.action-success:hover {
    background: #dcfce7;
}

.table-empty {
    padding: 30px !important;
    text-align: center !important;
    color: #718096;
}

.table-info {
    color: #718096;
    font-size: 10px;
}

.table-pagination {
    display: flex;
    gap: 4px;
}

.table-pagination button {
    min-width: 28px;
    height: 28px;
    padding: 0 7px;

    border: 1px solid #dce5ef;
    border-radius: 5px;

    background: #fff;
    color: #17263b;

    font-size: 10px;
}

.table-pagination button.active {
    border-color: #0969e8;
    background: #0969e8;
    color: #fff;
}

.table-pagination button:disabled {
    opacity: .45;
    cursor: not-allowed;
}

.table-page-size {
    padding: 7px 9px;
    border: 1px solid #dce5ef;
    border-radius: 5px;
    font-size: 10px;
}


/* =========================================================
   BADGE
========================================================= */

.badge {
    display: inline-block;

    padding: 4px 7px;

    border-radius: 5px;

    font-size: 9px;
    font-weight: 800;

    white-space: nowrap;
}

.badge.ready {
    border: 1px solid #a5e0bf;
    background: #e8f8ef;
    color: #168c50;
}

.badge.partial {
    border: 1px solid #ffbd8c;
    background: #fff0e4;
    color: #ef7713;
}

.badge.waiting {
    border: 1px solid #eedb83;
    background: #fff8df;
    color: #b27b00;
}

/* =========================================================
   DASHBOARD
========================================================= */

#dashboard-page {
    width: 100%;
    min-width: 0;
}

/* =========================================================
   KPI
========================================================= */

#dashboard-page .kpis {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
}

#dashboard-page .kpi {
    min-width: 0;
    padding: 14px;
    background: #fff;
    border: 1px solid #dce5ef;
    border-radius: 8px;
}

#dashboard-page .khead {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #53657a;
    font-size: 10px;
    font-weight: 800;
}

#dashboard-page .ki {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 32px;
    border-radius: 6px;
    font-size: 15px;
}

#dashboard-page .ki.b {
    background: #eaf3ff;
}

#dashboard-page .ki.g {
    background: #eaf8ef;
}

#dashboard-page .ki.o {
    background: #fff0e4;
}

#dashboard-page .kval {
    margin-top: 10px;
    color: #17263b;
    font-size: 20px;
    font-weight: 900;
}

#dashboard-page .trend {
    margin-top: 4px;
    color: #19a15f;
    font-size: 9px;
    font-weight: 700;
}

#dashboard-page .trend.muted {
    color: #718096;
}


/* =========================================================
   DASHBOARD GRID
========================================================= */

#dashboard-page .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(360px, .85fr);
    gap: 14px;
    align-items: start;
}

#dashboard-page .dashboard-grid > .card {
    min-width: 0;
    margin-bottom: 0;
}

#dashboard-page #ticketing {
    grid-column: 1;
    grid-row: 1 / span 2;
}

#dashboard-page #queue {
    grid-column: 2;
    grid-row: 1;
}

#dashboard-page #queue + .card {
    grid-column: 2;
    grid-row: 2;
}


/* =========================================================
   CARD TITLE
========================================================= */

#dashboard-page .card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 13px 15px;
    border-bottom: 1px solid #dce5ef;
    font-size: 11px;
    font-weight: 900;
}

#dashboard-page .card-body {
    padding: 15px;
}


/* =========================================================
   TICKETING
========================================================= */

#dashboard-page .ticket-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr);
    gap: 18px;
    align-items: start;
}


/* =========================================================
   STEPS
========================================================= */

#dashboard-page .steps {
    display: flex;
    align-items: center;
    margin-bottom: 18px;
}

#dashboard-page .step {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #718096;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
}

#dashboard-page .step.active {
    color: #0969e8;
}

#dashboard-page .step-number {
    width: 23px;
    height: 23px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #edf1f5;
    color: #718096;
    font-size: 10px;
    font-weight: 900;
}

#dashboard-page .step.active .step-number {
    background: #0969e8;
    color: #fff;
}

#dashboard-page .step-line {
    flex: 1;
    height: 1px;
    margin: 0 10px;
    background: #dce5ef;
}


/* =========================================================
   TICKETING FORM
========================================================= */

#dashboard-page .form-label {
    display: block;
    margin-bottom: 6px;
    color: #53657a;
    font-size: 10px;
    font-weight: 800;
}

#dashboard-page .form-label span {
    color: #9aa7b5;
    font-weight: 400;
}

#dashboard-page .counter {
    display: flex;
    width: 120px;
    height: 36px;
    margin-bottom: 5px;
}

#dashboard-page .counter button {
    width: 36px;
    border: 1px solid #dce5ef;
    background: #f8fafc;
    color: #17263b;
    font-size: 18px;
}

#dashboard-page .counter button:first-child {
    border-radius: 6px 0 0 6px;
}

#dashboard-page .counter button:last-child {
    border-radius: 0 6px 6px 0;
}

#dashboard-page .counter input {
    width: 48px;
    border: 1px solid #dce5ef;
    border-left: 0;
    border-right: 0;
    background: #fff;
    text-align: center;
    font-weight: 800;
}

#dashboard-page .form-help {
    margin-bottom: 17px;
    color: #718096;
    font-size: 9px;
}

#dashboard-page .form-select {
    width: 100%;
    height: 36px;
    padding: 0 10px;
    margin-bottom: 5px;
    border: 1px solid #dce5ef;
    border-radius: 6px;
    background: #fff;
    color: #17263b;
    font-size: 10px;
}

#dashboard-page .add-link {
    margin-bottom: 17px;
    color: #0969e8;
    font-size: 9px;
    font-weight: 700;
}


/* =========================================================
   TRANSACTION MODE
========================================================= */

#dashboard-page .transaction-mode {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 17px;
}

#dashboard-page .mode-box {
    padding: 10px;
    border: 1px solid #dce5ef;
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
}

#dashboard-page .mode-box.selected {
    border-color: #0969e8;
    background: #f2f7ff;
}

#dashboard-page .mode-box b {
    display: block;
    margin-bottom: 4px;
    font-size: 10px;
}

#dashboard-page .mode-box small {
    display: block;
    color: #718096;
    font-size: 8px;
    line-height: 1.4;
}


/* =========================================================
   TARIF
========================================================= */

#dashboard-page .tariff {
    padding: 12px;
    border: 1px solid #dce5ef;
    border-radius: 6px;
    background: #f8fafc;
}

#dashboard-page .tariff > b {
    display: block;
    margin-bottom: 8px;
    font-size: 10px;
}

#dashboard-page .tariff-row {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    color: #718096;
    font-size: 9px;
}

#dashboard-page .tariff-row b {
    color: #17263b;
}

#dashboard-page .tariff-total {
    display: flex;
    justify-content: space-between;
    margin-top: 7px;
    padding-top: 9px;
    border-top: 1px solid #dce5ef;
    color: #17263b;
    font-size: 10px;
    font-weight: 900;
}

#dashboard-page .tariff-total span:last-child {
    color: #0969e8;
    font-size: 13px;
}


/* =========================================================
   ACTION BUTTONS
========================================================= */

#dashboard-page .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
}

#dashboard-page .action-buttons .btn {
    min-height: 32px;
    font-size: 9px;
}


/* =========================================================
   POOLING INFO
========================================================= */

#dashboard-page .pool-info {
    margin-bottom: 12px;
    border: 1px solid #dce5ef;
    border-radius: 6px;
    overflow: hidden;
}

#dashboard-page .pool-header {
    padding: 10px 12px;
    border-bottom: 1px solid #dce5ef;
    background: #f8fafc;
    font-size: 10px;
    font-weight: 900;
}

#dashboard-page .pool-body {
    padding: 12px;
}

#dashboard-page .pool-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

#dashboard-page .pool-top small {
    display: block;
    color: #718096;
    font-size: 8px;
}

#dashboard-page .boat-name {
    margin-top: 2px;
    font-size: 15px;
    font-weight: 900;
}

#dashboard-page .pool-row {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    border-top: 1px solid #edf1f5;
    font-size: 9px;
}

#dashboard-page .pool-row span {
    color: #718096;
}

#dashboard-page .progress {
    height: 6px;
    margin-top: 9px;
    overflow: hidden;
    border-radius: 4px;
    background: #edf1f5;
}

#dashboard-page .progress i {
    display: block;
    height: 100%;
    background: #0969e8;
}


/* =========================================================
   PASSENGER
========================================================= */

#dashboard-page .passenger-list {
    margin: 0;
    padding: 0;
    list-style: none;
}

#dashboard-page .passenger-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid #edf1f5;
    font-size: 9px;
}

#dashboard-page .passenger-list li:last-child {
    border-bottom: 0;
}


/* =========================================================
   NOTICE
========================================================= */

#dashboard-page .notice {
    padding: 10px 12px;
    border: 1px solid #d6e8ff;
    border-radius: 6px;
    background: #eef6ff;
    color: #175ea9;
    font-size: 9px;
    line-height: 1.5;
}


/* =========================================================
   QUEUE
========================================================= */

#dashboard-page .queue-row {
    display: grid;
    grid-template-columns:
        28px
        minmax(90px, 1.2fr)
        minmax(65px, .8fr)
        minmax(65px, .8fr)
        minmax(80px, 1fr)
        70px;
    gap: 7px;
    align-items: center;
    padding: 10px 13px;
    border-bottom: 1px solid #edf1f5;
    font-size: 9px;
}

#dashboard-page .queue-row > * {
    min-width: 0;
}

#dashboard-page .queue-head {
    background: #f8fafc;
    color: #718096;
    font-weight: 900;
}

#dashboard-page .queue-row small {
    color: #718096;
    white-space: nowrap;
}

#dashboard-page .dispatch {
    min-height: 28px;
    padding: 6px 9px;
    border: 1px solid #0969e8;
    border-radius: 5px;
    background: #0969e8;
    color: #fff;
    font-size: 9px;
    font-weight: 800;
}

#dashboard-page .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    padding: 11px 13px;
    color: #718096;
    font-size: 8px;
}

#dashboard-page .legend span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}

#dashboard-page .legend i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
}

#dashboard-page .legend-ready {
    background: #19a15f;
}

#dashboard-page .legend-partial {
    background: #ef7713;
}

#dashboard-page .legend-waiting {
    background: #b27b00;
}

#dashboard-page .legend-departed {
    background: #718096;
}


/* =========================================================
   TRIP TABLE
========================================================= */

#dashboard-page .dashboard-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

#dashboard-page .dashboard-table th,
#dashboard-page .dashboard-table td {
    padding: 10px 12px;
    border-bottom: 1px solid #edf1f5;
    text-align: left;
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#dashboard-page .dashboard-table th {
    background: #f8fafc;
    color: #718096;
    font-size: 9px;
    font-weight: 900;
}


/* =========================================================
   POOLING ACTIVE
========================================================= */

#dashboard-page .pooling-card {
    margin-top: 14px;
}

#dashboard-page .pool-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    padding: 14px;
}

#dashboard-page .pool-card {
    min-width: 0;
    padding: 11px;
    border: 1px solid #dce5ef;
    border-radius: 6px;
    background: #fff;
}

#dashboard-page .pool-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
    margin-bottom: 9px;
}

#dashboard-page .pool-capacity {
    margin-bottom: 7px;
    font-size: 11px;
}

#dashboard-page .pool-card .small {
    margin-top: 4px;
    color: #718096;
    font-size: 8px;
}


/* =========================================================
   QUICK ACTION
========================================================= */

#dashboard-page .quick-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
    padding: 12px;
    border: 1px solid #dce5ef;
    border-radius: 8px;
    background: #fff;
}

#dashboard-page .quick-actions .btn {
    min-height: 31px;
    font-size: 9px;
}

#dashboard-page .system-status {
    margin-left: auto;
    color: #718096;
    font-size: 8px;
    line-height: 1.6;
    text-align: right;
}

#dashboard-page .system-status b {
    color: #19a15f;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1250px) {

    #dashboard-page .kpis {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #dashboard-page .dashboard-grid {
        grid-template-columns: 1fr;
    }

    #dashboard-page #ticketing,
    #dashboard-page #queue,
    #dashboard-page #queue + .card {
        grid-column: auto;
        grid-row: auto;
    }

    #dashboard-page .pool-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 900px) {

    #dashboard-page .kpis {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #dashboard-page .ticket-grid {
        grid-template-columns: 1fr;
    }

    #dashboard-page .pool-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {

    #dashboard-page .kpis {
        grid-template-columns: 1fr;
    }

    #dashboard-page .transaction-mode {
        grid-template-columns: 1fr;
    }

    #dashboard-page .pool-grid {
        grid-template-columns: 1fr;
    }

    #dashboard-page .queue-row {
        grid-template-columns: 25px 1fr 65px;
    }

    #dashboard-page .queue-row > *:nth-child(4),
    #dashboard-page .queue-row > *:nth-child(5) {
        display: none;
    }

    #dashboard-page .system-status {
        width: 100%;
        margin-left: 0;
        text-align: left;
    }
}
